{
  "$schema": "https://t3.codes/schema/t3.json",
  "defaultThreadEnvMode": "worktree",
  "scripts": [
    {
      "name": "Setup worktree",
      "command": "pnpm install --frozen-lockfile",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Start dev server (demo data)",
      "command": "MAIL_REVIEW_DEMO=1 pnpm dev",
      "icon": "play",
      "stopOnSettle": true
    },
    {
      "name": "Run checks",
      "command": "pnpm check",
      "icon": "test"
    },
    {
      "name": "Build",
      "command": "pnpm build",
      "icon": "build"
    },
    {
      "name": "Browser tests",
      "command": "pnpm test:e2e",
      "icon": "test"
    }
  ]
}
