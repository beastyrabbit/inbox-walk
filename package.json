{
  "name": "inbox-walk",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "infisical run --silent --domain=http://192.168.60.11:8080 --projectId=63e82e5b-8d34-4658-a4d3-2320521588d1 --env=dev --path=/tools/fastmail -- sh -c 'exec env FASTMAIL_JMAP_TOKEN=\"$FASTMAIL_MCP_TOKEN\" CODEX_MODEL=gpt-5.6-sol TIKA_URL=http://127.0.0.1:9998 vite'",
    "dev:portless": "portless inbox-walk pnpm dev",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "tsc -b && vite build",
    "build:server": "tsup server/index.ts --format esm --platform node --target node24 --out-dir dist-server --clean --sourcemap",
    "start": "node dist-server/index.js",
    "check": "biome check . && tsc -b && vitest run",
    "format": "biome check --write .",
    "lint": "biome check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "hooks:install": "lefthook install"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.80.7",
    "@earendil-works/pi-coding-agent": "0.80.7",
    "dompurify": "^3.4.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typebox": "1.1.38",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.3.0"
}
