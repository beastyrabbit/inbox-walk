# Create a personal Fastmail API token with Mail access:
# https://www.fastmail.com/settings/security/tokens
FASTMAIL_JMAP_TOKEN=

# Non-secret runtime settings. Local development reuses ~/.pi/agent/auth.json.
CODEX_MODEL=gpt-5.6-sol
TIKA_URL=http://127.0.0.1:9998

# Explicitly opt into the built-in sample inbox. Production must leave this at 0.
MAIL_REVIEW_DEMO=0
