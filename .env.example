# Copy this file to .env for local development. Keep .env out of Git.
# Use a dedicated, least-privileged Fastmail token for local work.
FASTMAIL_JMAP_TOKEN=

# Non-secret runtime settings.
CODEX_MODEL=gpt-5.6-sol
CODEX_THINKING_LEVEL=high
CODEX_SPEED=standard
CODEX_INFERENCE_TIMEOUT_MS=300000
DATA_DIR=./data
TIKA_URL=http://127.0.0.1:9998
TRIAGE_POLL_INTERVAL_MS=60000
TRIAGE_TIMEOUT_MS=900000
MAIL_REVIEW_DEMO=0
